# SPDX-License-Identifier: Apache-2.0
# SONiC ChaosLab — API credentials (copy to .env; .env is git-ignored).
# The app reads keys from the environment ONLY. Keys are never written to
# ~/.chaoslab/settings.json. Leave blank to use the default fake provider.

# Primary model provider.
ANTHROPIC_API_KEY=
# Required only for default (non-workspace-scoped) Anthropic keys:
ANTHROPIC_WORKSPACE_ID=

# Free-tier fallbacks (optional).
GEMINI_API_KEY=
# Groq free tier. Paste your key below, then select it as the active provider:
#   chaoslab settings set provider groq
# (Model defaults to llama-3.1-8b-instant; override with: settings set groq_model <id>.)
GROQ_API_KEY=

# Local fallback (optional). Only the host URL is needed; no key.
# OLLAMA_HOST=http://localhost:11434
